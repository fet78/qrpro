{
  "name": "qrpro",
  "version": "1.0.0",
  "private": true,
  "description": "QR codes permanents et étiquettes pour chauffagistes, plombiers et pros du bâtiment.",
  "scripts": {
    "predev": "node scripts/db-start.mjs",
    "db:start": "node scripts/db-start.mjs",
    "dev": "next dev --webpack -p 3500",
    "build": "next build --webpack",
    "start": "next start -p 3500",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx --conditions=react-server prisma/seed.ts",
    "admin:create": "tsx --conditions=react-server scripts/create-admin.ts",
    "test:e2e": "node tests/e2e/flow.mjs",
    "test:print": "tsx --conditions=react-server tests/print-check/render.ts && python tests/print-check/rasterize.py 300 && tsx tests/print-check/decode.ts && python tests/print-check/rasterize.py 150 && tsx tests/print-check/decode.ts",
    "test:vitrine": "node tests/e2e/vitrine.mjs"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@pdf-lib/standard-fonts": "^1.0.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "clsx": "^2.1.1",
    "jsqr": "^1.4.0",
    "lucide": "^1.70.0",
    "lucide-react": "^1.52.0",
    "next": "^16.4.6",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "stripe": "^23.2.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@next/swc-wasm-nodejs": "^16.4.6",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.15.6",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.6.1",
    "dotenv": "^18.0.5",
    "playwright-core": "^1.63.0",
    "postcss": "^8.5.29",
    "prisma": "^7.10.0",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20.19"
  },
  "overrides": {
    "effect": "3.22.5"
  }
}

# ─── Base de données PostgreSQL ─────────────────────────────────────────────
# Production (Prisma Postgres, console.prisma.io) : l'URL « pooled » (hôte pooled.db.prisma.io) pour l'application.
# DATABASE_URL="postgres://UTILISATEUR:MOT_DE_PASSE@pooled.db.prisma.io:5432/postgres?sslmode=require"
# Migrations (npm run db:deploy, depuis votre poste) : l'URL directe (hôte db.prisma.io).
# Développement local : base jetable « npx prisma dev --name qrpro » (voir README).
DATABASE_URL=""
# Connexions par instance (facultatif). Vide en production serverless : 1 automatiquement (Netlify, Vercel).
# « 1 » pour « prisma dev » en local.
DATABASE_POOL_MAX=""

# Adresse publique du site, SANS barre finale. C'est l'adresse imprimée dans les QR codes :
# choisissez votre domaine définitif AVANT de générer des étiquettes.
APP_URL="https://www.votre-domaine.fr"

# Secret des sessions (32 caractères minimum). Générer : node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""

# ─── Stripe (paiements) ─────────────────────────────────────────────────────
# dashboard.stripe.com → Développeurs → Clés API. Commencez en mode test (sk_test_…).
STRIPE_SECRET_KEY=""
# Développeurs → Webhooks → Ajouter un endpoint : https://www.votre-domaine.fr/api/stripe/webhook
# Événements : checkout.session.completed, checkout.session.async_payment_succeeded, checkout.session.expired
STRIPE_WEBHOOK_SECRET=""

# ─── Resend (emails) ────────────────────────────────────────────────────────
# resend.com → API Keys. EMAIL_FROM doit utiliser un domaine vérifié dans Resend.
RESEND_API_KEY=""
EMAIL_FROM="QR Pro <notifications@votre-domaine.fr>"
# Facultatif : reçoit les alertes (nouvelle commande, nouveau compte, ticket support).
ADMIN_NOTIFY_EMAIL=""

# ─── Notifications des nouvelles demandes : 0 € / mois ──────────────────────
# Deux canaux GRATUITS seulement : notification web (push) et email Resend (offre gratuite).
# Aucun SMS ni WhatsApp : rien ne peut être facturé au message.

# Notifications web (GRATUIT, canal principal) : générez une paire de clés une seule fois
#   npx web-push generate-vapid-keys
# et gardez les MÊMES clés ensuite (en changer désabonne tous les appareils des pros).
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:contact@votre-domaine.fr"

# Limites de l'offre gratuite Resend (à la date d'écriture : 100 emails / jour, 3 000 / mois).
# L'application s'arrête d'elle-même avant : pas de dépassement. Les notifications gardent une marge
# (10 / jour, 100 / mois) pour les emails de compte (mot de passe oublié, confirmations de commande).
EMAIL_DAILY_LIMIT=100
EMAIL_MONTHLY_LIMIT=3000

# Facultatif : reprise automatique des envois en échec temporaire, toutes les 10 minutes
#   GET https://www.votre-domaine.fr/api/cron/notifications   avec l'en-tête   Authorization: Bearer <CRON_SECRET>
# (cron-job.org est gratuit). Générez : openssl rand -hex 24
CRON_SECRET=""
